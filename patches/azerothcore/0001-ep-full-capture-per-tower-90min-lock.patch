+
+OPvPCapturePointEP_Lockable::OPvPCapturePointEP_Lockable(
+    OutdoorPvP* pvp, uint8 towerIndex)
+    : OPvPCapturePoint(pvp), m_TowerIndex(towerIndex)
+{
+}
+
+void OPvPCapturePointEP_Lockable::SaveTowerLock(
+    TeamId team, uint32 expiresAt) const
+{
+    // These four owner/expiry pairs occupy a separately reserved namespace.
+    // Backup and collision-check the characters DB worldstates table before
+    // installing the patch. Inconsistent pairs fail neutral on next startup.
+    // Persist the expiry first: an interrupted new lock with no owner is inert.
+    sWorldState->setWorldState(
+        EP_TOWER_LOCK_EXPIRY_STATE_BASE + m_TowerIndex, expiresAt);
+    sWorldState->setWorldState(
+        EP_TOWER_LOCK_OWNER_STATE_BASE + m_TowerIndex, uint32(team));
+}
+
+void OPvPCapturePointEP_Lockable::ResetToNeutral()
+{
+    m_LockExpiresAt = 0;
+    // Clear saved ownership first; a crash between the writes must not
+    // resurrect an apparently valid lock with an expired timestamp.
+    sWorldState->setWorldState(
+        EP_TOWER_LOCK_OWNER_STATE_BASE + m_TowerIndex,
+        uint32(TEAM_NEUTRAL));
+    sWorldState->setWorldState(
+        EP_TOWER_LOCK_EXPIRY_STATE_BASE + m_TowerIndex, 0);
+
+    _oldState = _state;
+    _state = OBJECTIVESTATE_NEUTRAL;
+    _team = TEAM_NEUTRAL;
+    _value = 0.0f;
+    m_SilentLockTransition = true;
+    ChangeState(); // preserves each tower's ordinary gameplay cleanup
+    m_SilentLockTransition = false;
+    SendChangePhase();
+}
+
+bool OPvPCapturePointEP_Lockable::Update(uint32 diff)
+{
+    uint64 const now = uint64(GameTime::GetGameTime().count());
+
+    if (m_LockExpiresAt)
+    {
+        // Maintain proximity/UI player membership without allowing even a
+        // single tick of capture-point movement while this tower is locked.
+        OPvPCapturePoint::Update(0);
+        if (now < m_LockExpiresAt)
+            return false;
+
+        ResetToNeutral();
+        return true;
+    }
+
+    bool const changed = OPvPCapturePoint::Update(diff);
+
+    // The vanilla objective can become Alliance/Horde controlled at the
+    // neutral threshold, BEFORE 100%. Never use ChangeState to start a lock.
+    // _value is clamped by the core to +/- _maxValue at true full capture.
+    if (_maxValue > 0.0f && (
+        (_state == OBJECTIVESTATE_ALLIANCE && _team == TEAM_ALLIANCE &&
+            _value >= _maxValue) ||
+        (_state == OBJECTIVESTATE_HORDE && _team == TEAM_HORDE &&
+            _value <= -_maxValue)))
+    {
+        uint64 const expiresAt = now + EP_TOWER_LOCK_SECONDS;
+        // DB/world-state dates are stored as uint32 Unix seconds.
+        if (expiresAt <= UINT32_MAX)
+        {
+            m_LockExpiresAt = uint32(expiresAt);
+            SaveTowerLock(_team, m_LockExpiresAt);
+        }
+    }
+    return changed;
+}
+
+void OPvPCapturePointEP_Lockable::RestoreTowerLock()
+{
+    uint64 const owner = sWorldState->getWorldState(
+        EP_TOWER_LOCK_OWNER_STATE_BASE + m_TowerIndex);
+    uint64 const expiry = sWorldState->getWorldState(
+        EP_TOWER_LOCK_EXPIRY_STATE_BASE + m_TowerIndex);
+    uint64 const now = uint64(GameTime::GetGameTime().count());
+
+    if (!owner && !expiry)
+        return;
+
+    // Treat stale, impossible, future-skewed, truncated or conflicting DB
+    // values as neutral. Never silently extend a lock after downtime.
+    if ((owner != uint64(TEAM_ALLIANCE) && owner != uint64(TEAM_HORDE)) ||
+        expiry <= now || expiry > now + EP_TOWER_LOCK_SECONDS ||
+        expiry > UINT32_MAX || _maxValue <= 0.0f)
+    {
+        SaveTowerLock(TEAM_NEUTRAL, 0);
+        return;
+    }
+
+    TeamId const team = TeamId(owner);
+    _oldState = OBJECTIVESTATE_NEUTRAL;
+    _state = team == TEAM_ALLIANCE ?
+        OBJECTIVESTATE_ALLIANCE : OBJECTIVESTATE_HORDE;
+    _team = team;
+    _value = team == TEAM_ALLIANCE ? _maxValue : -_maxValue;
+    m_LockExpiresAt = uint32(expiry);
+
+    // Restore original owner, icon and faction-specific tower benefits, but
+    // do not issue a new capture announcement or quest credit on reboot.
+    m_SilentLockTransition = true;
+    ChangeState();
+    m_SilentLockTransition = false;
+}
