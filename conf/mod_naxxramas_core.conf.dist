#####################################
# Honor Overflow
#####################################

# Enable conversion of Honor earned above the normal Honor cap.
# Default: 1
NaxxramasCore.HonorOverflow.Enabled = 1

# Copper awarded for every 1 excess Honor point.
#
# 10 Copper per Honor means:
# 100 Honor   = 10 Silver
# 1,000 Honor = 1 Gold
#
# Default: 10
NaxxramasCore.HonorOverflow.CopperPerHonor = 10

# Send the player a message when excess Honor is converted.
# Default: 1
NaxxramasCore.HonorOverflow.Notify = 1

# Allow Playerbots to receive gold from excess Honor.
# Recommended: 0
# Default: 0
NaxxramasCore.HonorOverflow.IncludeBots = 0


#####################################
# Fortnightly Honor Reset
#####################################

# Enable automatic Honor resets.
# Default: 0
NaxxramasCore.HonorReset.Enabled = 1

# Number of weeks between Honor resets.
# 2 = every fortnight.
# Default: 2
NaxxramasCore.HonorReset.IntervalWeeks = 2

# Day of the week to perform the reset.
# 0 = Sunday
# 1 = Monday
# 2 = Tuesday
# 3 = Wednesday
# 4 = Thursday
# 5 = Friday
# 6 = Saturday
# Default: 3
NaxxramasCore.HonorReset.DayOfWeek = 3

# Hour of the reset, using server local time.
# 0-23
# Default: 6
NaxxramasCore.HonorReset.Hour = 6

# Minute of the reset.
# Default: 0
NaxxramasCore.HonorReset.Minute = 0

# Anchor date used to determine the first Wednesday
# of the fortnightly reset cycle.
#
# Format: YYYY-MM-DD
#
# 2026-10-07 gives:
#   7 October 2026
#   21 October 2026
#   4 November 2026
#   18 November 2026
#   etc.
NaxxramasCore.HonorReset.AnchorDate = "2026-10-07"

# Notify online players when the reset occurs.
# Default: 1
NaxxramasCore.HonorReset.Notify = 1

#####################################
# Monthly Elemental Invasions
#####################################

# Calendar-based control of the ORIGINAL AzerothCore Elemental Invasions
# game event (eventEntry 13). Requires game_event.world_event = 5
# (GAMEEVENT_INTERNAL) in the world database; see module SQL and docs.
# Other events are not affected.
#
# 1 = automatic monthly invasions
# 0 = do not control event 13 (default, safe until SQL is applied)
# Default: 0
NaxxramasCore.ElementalInvasion.Enabled = 0

# Invasion begins on the 1st of each calendar month at this
# SERVER-LOCAL clock time. No fixed 30-day recurrence is used.
# Default: 0 (midnight)
NaxxramasCore.ElementalInvasion.Hour = 0
NaxxramasCore.ElementalInvasion.Minute = 0

# Number of calendar days active, starting on the 1st.
# 5 means 1st 00:00 through 6th 00:00 (end exclusive).
# Range 1-27; out-of-range settings are clamped.
# Default: 5
NaxxramasCore.ElementalInvasion.DurationDays = 5

#####################################
# Forced PvP Zones
#####################################

# Master switch for forced PvP zones.
# Default: 1
NaxxramasCore.ForcedPvP.Enabled = 1

# Force normal faction PvP throughout Silithus.
# Default: 1
NaxxramasCore.ForcedPvP.Silithus = 1

# Force normal faction PvP throughout Eastern Plaguelands.
# Default: 1
NaxxramasCore.ForcedPvP.EasternPlaguelands = 1

# Apply forced PvP rules to Playerbots.
# Default: 1
NaxxramasCore.ForcedPvP.IncludeBots = 1

# Notify players when they enter a forced PvP zone.
# Default: 1
NaxxramasCore.ForcedPvP.Notify = 1

#####################################
# Naxxramas Talent Calculator -> Playerbots (NT1)
#####################################

# Controls who can use the NT1 Playerbot Talent Import system.
#
# 0 = Disabled
# 1 = GM accounts only (preview and experimental apply)
# 2 = All players (preview and experimental apply)
# 3 = GM accounts ONLY (preview/project/repairpreview, NEVER apply)
# 4 = All players (preview/project/repairpreview, NEVER apply)
#     Non-GMs must control the target bot; Alt repair inspection
#     additionally requires their character in AltBotAllowedPlayers.
#
# Modes 3 and 4 are intended for controlled read-only testing.
# Mode 3 is GM-only; mode 4 allows normal players with existing
# ownership/master requirements. Neither mode can reset talent builds.
# Existing modes 1 and 2 still allow talent application. Applying builds is still
# EXPERIMENTAL: back up the characters DB and verify a recovery procedure
# before enabling on a live realm. An interrupted reset is not transactional.
# Non-GMs may target only their same-account bots or directly mastered bots.
# Applying to a RANDOM bot additionally requires the issuer to be grouped
# with it and be its current human master (or group leader if no master).
# Random-bot imports do not keep permanent NT1 profiles. Playerbots may
# still reroll those talents during or after the party.
# Every NT1 apply REQUIRES the build to spend ALL talent points available
# to the bot's current level (as calculated by the server). Incomplete
# builds are rejected before a talent reset; preview shows a warning.
# The talent code's era must also EXACTLY match the issuing character's
# Individual Progression expansion: Vanilla (< stage 8), TBC (8-12),
# WotLK (13+). This applies to GMs, Alt Bots and Random Playerbots.
# Both preview and apply reject wrong-era codes; no talents are reset.
# When IndividualProgression.Enable=0, the existing bot-level era
# restrictions still apply without a player-progression restriction.
# This does not affect normal Playerbots talent templates or whispers.
# Invalid values fail closed to 0 (disabled).
#
# Commands:
# .naxxbot talents preview <online-botname> <NT1-code>
# .naxxbot talents project <online-botname> <NT1L1-code>   (read-only)
# .naxxbot talents repairpreview <online-altbot> <NT1-code> (read-only)
# .naxxbot talents safetypreview <online-altbot> (read-only, no NT1 code)
# .naxxbot talents apply <online-botname> <NT1-code>
# In mode 3 or 4, all four diagnostic commands are usable;
# the Apply handler refuses before reset, even for GMs. repairpreview
# and safetypreview enforce AltBotAllowedPlayers (including GMs).
# safetypreview needs only an online Alt Bot name (no NT1 talent code).
# It reports the issuing HUMAN's effective IP era/stage if IP is enabled
# and compares both specs' existing DBC ranks with that issuer era.
# Per-spec examples are capped at 3. This is NOT full build validation,
# proof of the bot's IP stage, permission to Apply or gear/pet safety.
# IP-disabled does not perform a no-code era comparison.
#
# Default: 0
NaxxramasCore.BotTalentImport.AccessMode = 0

# Alt Bot NT1 application permission list.
# Comma-separated HUMAN PLAYER CHARACTER names (not Alt Bot names).
# Example to copy into your ACTIVE config:
# NaxxramasCore.BotTalentImport.AltBotAllowedPlayers = "Takali, Drakka, Sequoia"
#
# Only these characters can run .naxxbot talents apply on Alt Bots.
# Names match exactly, ignoring case and spaces around the commas.
# Trailing commas are harmless. An empty list DENIES all Alt Bot applies,
# including GM attempts. Read-only preview is still available to callers
# allowed by AccessMode. This is an additional check, not an override:
# AccessMode 1 remains GM-only; modes 2 and 4 still check normal-player
# bot ownership/master permissions. Random Playerbots are UNAFFECTED.
# Mode 4 allows read-only tests without enabling experimental Apply.
# NT1 imports do not touch Alt Bot EQUIPMENT; any future role-autogear
# feature must be restricted to Random Playerbots only.
#
# Default: "" (deny all Alt Bot apply)
NaxxramasCore.BotTalentImport.AltBotAllowedPlayers = ""

#####################################
# Playerbot Talent Completion
#####################################

# Guard whispered/group bot talent specs against later-level template bleed,
# and finish legal talent ranks left unspent after a no-cost respec.
# Requires AiPlayerbot.LimitTalentsExpansion = 1.
# The existing Playerbots talent limits and human player builds are unchanged.
# Safe default is disabled; enable explicitly after reviewing and testing changes.
# Default: 0 (disabled)
NaxxramasCore.BotTalentCompletion.Enabled = 0


#####################################
# Individual Progression - Meeting Stones
#####################################

# Make meeting stones decorative (non-summoning) for players who have
# not yet entered The Burning Crusade in Individual Progression.
# Players at TBC or WotLK progression use normal AzerothCore meeting stones.
# Affects the player interacting with the stone, not all stones globally.
# No DBC, SQL, or AzerothCore core modifications are required.
#
# 1 = Restrict Vanilla players (default)
# 0 = Unrestricted standard WotLK meeting stones for everybody
# Default: 1
NaxxramasCore.MeetingStones.ClassicMode.Enabled = 1

#####################################
# Individual Progression - Classic Battlemaster Queues
#####################################

# 1: Before the configured unlock tier, require players to queue at
#    a nearby Battlemaster. Remote joins (including macros) are blocked.
# 0: Use original WotLK remote queue functionality for all characters.
# Feature is DISABLED by default until build/in-game testing is complete.
# Default: 0
NaxxramasCore.BattlegroundQueue.ClassicMode.Enabled = 0

# Individual Progression milestone that unlocks remote queueing.
# Modern IP: 13 = WotLK entry (after TBC Tier 5); 14 = Ulduar tier.
# Accepted: 1-18. Out-of-range values fall back to 13.
# Default: 13
NaxxramasCore.BattlegroundQueue.ClassicMode.UnlockStage = 13

# GMs can remotely queue regardless of stage. Default: 1
NaxxramasCore.BattlegroundQueue.ClassicMode.ExemptGMs = 1

# Preserve Playerbots queues based on IndividualProgression.BotAccountsRegex.
# Default: 1
NaxxramasCore.BattlegroundQueue.ClassicMode.ExemptPlayerbots = 1

#####################################
# Human hunter pet autocast restore
#####################################

# EXPERIMENTAL prototype, default off. Not a functional persistence fix.
# BLOCKED: NO ATOMIC MODULE-ONLY CHOICE SOURCE.
# The module cannot tell a player's latest explicit OFF from Individual
# Progression's learn-default OFF, so it does not turn a rank ON.
# Setting this to 1 still does not toggle a pet. A missing account name,
# an empty or invalid pattern, a pet GUID change, logout, removal from
# the world, more than one autocast chain, or an explicit OFF the new
# rank does not already show aborts with no write. Unvalidated client
# autocast packets are ignored. Explicit OFF is not written. Stale
# old-rank autocast ids can remain.
#
# 0 = do nothing (default)
# 1 = experimental hooks only; functional ON restore stays closed
# Default: 0
NaxxramasCore.HunterPetAutocastRestore.Enabled = 0

#####################################
# Hunter pet autocast cache
#####################################

# Separate from HunterPetAutocastRestore. Default off. Does nothing until
# set to 1 only after the owner has backed up the characters database and
# applied data/sql/db-characters/2026_10_20_00_hunter_pet_autocast_cache.sql.
# This module does not apply that file. While the seven-column table is
# absent, an enabled module can still restore characters.pet_spell bits and
# will not turn new damage chains on.
#
# OnPetAddToWorld runs before _LoadSpells. The hook only queues a pet event.
# The event does not read the spellbook or the charm bar while the pet is
# still loading. After load it requires one character_pet row for this owner
# and pet number, then reads pet_spell. The charm bar is not the saved book.
# Re-apply follows that event clock: no load-time pumps, cover is 201ms after
# the snapshot tick (IP's first delay is 200ms). If a load-time pump was
# observed, cover is IP's full 2200ms retry budget. Utility chains are never
# written. There is no migration: a saved off bit stays off.
#
# 0 = do nothing, and do not query (default)
# 1 = queue the event for human hunters
# Default: 0
NaxxramasCore.HunterPet.AutocastCache.Enabled = 0

# Account names that match are skipped, same idea as
# IndividualProgression.BotAccountsRegex (IPSpells.cpp bot return).
# No Playerbots dependency. Empty or invalid fails closed (no restore).
# Default: ^RNDBOT.*
NaxxramasCore.HunterPet.AutocastCache.BotAccountsRegex = "^RNDBOT.*"

# First-rank spell ids turned ON when the chain is new (tame, new ability).
# A chain already in the snapshot keeps the saved on/off bit instead.
# Comma-separated. An empty value turns the allowlist off.
# Screech and Demoralizing Screech are 24423. Pummel is 26090.
# Default: the 3.3.5a damage list below
NaxxramasCore.HunterPet.AutocastCache.DamageSpellIds = "17253,16827,49966,24844,34889,24640,35387,24423,55749,35290,50518,56626,50274,50271,50245,54680,50498,57386,50541,50519,50256,54706,54644,61193,50285,26090"

# First-rank ids the module never writes, even if they are also listed above.
# Growl, Cower, Dash, Dive, Charge, Prowl, Shell Shield, Roar of Recovery,
# Roar of Sacrifice, Rabid, Intervene, Last Stand, Heart of the Phoenix,
# Call of the Wild, Taunt, Thunderstomp (26094), Warp.
# Default: the utility list below
NaxxramasCore.HunterPet.AutocastCache.UtilitySpellIds = "2649,1742,61684,23145,61685,24450,26064,53517,53480,53401,53476,53478,55709,53434,53477,26094,35346"

# Optional first ranks. Empty by default, so a NEW chain is not turned on.
# A saved on/off already in the snapshot is still restored.
# Owner judgement, out by default: Furious Howl 24604, Wolverine Bite 53508,
# Web 4167, Lava Breath 58604. Bad Manner has no 3.3.5a id. Bad Attitude
# (crocolisk) is 50433 and is not included.
# Default: empty
NaxxramasCore.HunterPet.AutocastCache.OptionalSpellIds = ""
